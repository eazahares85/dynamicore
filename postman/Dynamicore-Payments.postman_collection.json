{
  "info": {
    "_postman_id": "dynamicore-payments-collection",
    "name": "Dynamicore - Sistema de Pagos",
    "description": "Colección para probar el API REST del sistema de pagos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "usuarioId",
      "value": "1"
    },
    {
      "key": "tarjetaId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "API Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Crear usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('usuarioId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Pérez\",\n  \"email\": \"juan.perez@ejemplo.com\"\n}"
            },
            "url": "{{baseUrl}}/api/usuarios"
          }
        },
        {
          "name": "Obtener usuario por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/usuarios/{{usuarioId}}"
          }
        }
      ]
    },
    {
      "name": "Tarjetas",
      "item": [
        {
          "name": "Registrar tarjeta (ficticia)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('tarjetaId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero_tarjeta\": \"4111111111111111\",\n  \"titular\": \"JUAN PEREZ\",\n  \"mes_vencimiento\": 12,\n  \"anio_vencimiento\": 2028,\n  \"marca\": \"visa\"\n}"
            },
            "url": "{{baseUrl}}/api/usuarios/{{usuarioId}}/tarjetas"
          }
        },
        {
          "name": "Listar tarjetas del usuario",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/usuarios/{{usuarioId}}/tarjetas"
          }
        }
      ]
    },
    {
      "name": "Pagos",
      "item": [
        {
          "name": "Crear pago",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario_id\": {{usuarioId}},\n  \"tarjeta_id\": {{tarjetaId}},\n  \"monto\": 150.75\n}"
            },
            "url": "{{baseUrl}}/api/pagos"
          }
        },
        {
          "name": "Historial de pagos del usuario",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/pagos/usuarios/{{usuarioId}}"
          }
        }
      ]
    }
  ]
}
